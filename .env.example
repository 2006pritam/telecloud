# --- Telegram (MTProto) -----------------------------------------------------
# Get these from https://my.telegram.org → API development tools.
# They identify the app, not your account. Leave blank to run the local demo.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Configure one pair for the application. Each visitor signs in with their own
# phone number, Telegram login code, and optional two-step verification password.
# Each account gets its own private "Telecloud Storage" channel and file database.

# --- Site access ------------------------------------------------------------
# Optional extra site password. Leave blank to let anyone sign in with Telegram.
# In demo mode this password is the only access control.
APP_PASSWORD=
# Optional extra key for hashing browser session tokens. Keep stable across restarts.
SESSION_SECRET=
HOST=127.0.0.1
PORT=3001
# Set true when serving the public app over HTTPS.
COOKIE_SECURE=false
# Set to the number of trusted reverse proxies in front of the app (usually 1).
# Keep 0 when clients connect directly. The proxy must preserve the Host header.
TRUST_PROXY=0

# Account databases, Telegram sessions, browser sessions, and demo files live here.
DATA_DIR=./data
